    "views": [
      {
        "id": "main-path",
        "label": "成功主路徑",
        "focus": [
          "grill",
          "planner",
          "brancher",
          "implementer",
          "reviewer",
          "publisher",
          "pr"
        ],
        "note": "grill 收斂需求 → planner 規格與計畫 → brancher 建 worktree → implementer 實作 → reviewer 審查 → publisher 發布 → PR 建立。這是唯一的成功路徑。"
      },
      {
        "id": "inference-tier",
        "label": "推論等級分配",
        "focus": [
          "planner",
          "implementer",
          "verifier",
          "reviewer"
        ],
        "note": "最強推論（opus · xhigh）只給 planner、reviewer、verifier；implementer 為 sonnet · max，並逐任務再分級。"
      },
      {
        "id": "delegation",
        "label": "MCP 委派邊界",
        "focus": [
          "brancher",
          "implementer",
          "publisher",
          "mcp"
        ],
        "note": "純 IO 與重活委派 gemini-mcp-tool；規劃、審查、對外動作不委派。"
      },
      {
        "id": "guards",
        "label": "Hook 與狀態守衛",
        "focus": [
          "wfstate",
          "hook_stage",
          "hook_cwd",
          "hook_reindex"
        ],
        "note": "wf-state.sh 棘輪擋未確認的 advance；三道 hook 由 settings.local.json 註冊，只有 exit 2 具阻擋力。"
      }
    ]
